#!/bin/bash
# Stop a previous Galaxy USB Tether launchd job before Installer replaces its
# files.  The explicit system domain is the boot volume's launchd domain.
set -eu

LABEL="local.galaxy-usb-tether"
TARGET_VOLUME="${3:-/}"

if [ "$TARGET_VOLUME" != "/" ]; then
    echo "Galaxy USB Tether: installation is restricted to the boot volume" >&2
    exit 1
fi

if /bin/launchctl print "system/${LABEL}" >/dev/null 2>&1; then
    /bin/launchctl bootout "system/${LABEL}" >/dev/null 2>&1 || true
fi

exit 0
